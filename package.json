{
  "name": "forma-production-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/lib/*.test.ts server/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

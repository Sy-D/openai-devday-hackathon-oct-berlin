# Copy to .env and fill in — .env is gitignored, never commit real values.
# FORMA delivery chat (default provider). Use .env.local for local Next.js development.
DELIVERY_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional alternate provider: set DELIVERY_AI_PROVIDER=nebius.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3
TAVILY_API_KEY=

# Optional production-planning assistant. Keep credentials server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Standalone assistant verification only; the Next app uses native API routes.
API_PORT=8789
